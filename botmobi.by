# =========================================================
# إرسال التذكير
# =========================================================

async def execute_reminder(reminder):

    guild = bot.get_guild(reminder["guild_id"])

    if guild is None:
        return

    role = guild.get_role(reminder["role_id"])

    if role is None:
        await send_log(
            guild,
            (
                f"❌ فشل إرسال التذكير `{reminder['id']}`\n"
                f"السبب: الرتبة غير موجودة."
            )
        )
        return

    sent = 0
    failed = 0

    for member in role.members:

        if member.bot:
            continue

        try:
            embed = discord.Embed(
                title="🔔 تذكير",
                description=(
                    f"{member.mention}\n\n"
                    f"{reminder['message']}"
                ),
                color=discord.Color.blurple()
            )

            embed.set_footer(
                text=f"تذكير #{reminder['id']}"
            )

            await member.send(embed=embed)

            sent += 1

        except (
            discord.Forbidden,
            discord.HTTPException
        ):
            failed += 1

    await send_log(
        guild,
        (
            f"📨 **تم تنفيذ التذكير**\n"
            f"🆔 **رقم التذكير:** `{reminder['id']}`\n"
            f"🎯 **الرتبة:** `{role.name}`\n"
            f"✅ **تم الإرسال:** `{sent}`\n"
            f"❌ **فشل الإرسال:** `{failed}`"
        )
    )


# =========================================================
# فحص التذكيرات
# =========================================================

@tasks.loop(seconds=30)
async def reminder_checker():

    now = datetime.now(TIMEZONE)

    changed = False

    for reminder in data["reminders"]:

        if not reminder["active"]:
            continue

        try:
            next_run = datetime.fromisoformat(
                reminder["next_run"]
            )
        except (ValueError, TypeError):
            continue

        if now >= next_run:

            await execute_reminder(reminder)

            next_run = next_run + timedelta(days=7)

            reminder["next_run"] = next_run.isoformat()

            changed = True

    if changed:
        save_data()


@reminder_checker.before_loop
async def before_reminder_checker():
    await bot.wait_until_ready()


# =========================================================
# تشغيل البوت
# =========================================================

@bot.event
async def on_ready():

    print(f"✅ تم تسجيل الدخول: {bot.user}")

    try:
        synced = await bot.tree.sync()
        print(f"✅ تم تسجيل {len(synced)} أمر.")
    except Exception as error:
        print(f"❌ خطأ في تسجيل الأوامر: {error}")

    if not reminder_checker.is_running():
        reminder_checker.start()


# =========================================================
# الأخطاء
# =========================================================

@bot.tree.error
async def on_app_command_error(
    interaction: discord.Interaction,
    error: app_commands.AppCommandError
):

    print(f"❌ Command Error: {error}")

    try:
        if interaction.response.is_done():
            await interaction.followup.send(
                "❌ حدث خطأ أثناء تنفيذ الأمر.",
                ephemeral=True
            )
        else:
            await interaction.response.send_message(
                "❌ حدث خطأ أثناء تنفيذ الأمر.",
                ephemeral=True
            )
    except discord.DiscordException:
        pass


# =========================================================
# تشغيل
# =========================================================

bot.run(TOKEN)